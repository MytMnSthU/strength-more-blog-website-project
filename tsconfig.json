{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"skipLibCheck": true,

		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"noEmit": true,

		"strict": true,
		"allowJs": true,
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./src/*"]
		},
		"jsx": "react-jsx"
	},
	"include": ["src"]
}
